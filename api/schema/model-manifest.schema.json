{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lykuro:nie:model-manifest:v1",
  "title": "Lykuro Model Artifact Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_id", "model_family", "architecture",
    "model_version", "weight_format", "precision", "vocab_size",
    "hidden_size", "num_layers", "num_attention_heads",
    "num_key_value_heads", "head_dim", "max_context_tokens",
    "tokenizer_type", "chat_template_id", "files", "license_review_id",
    "certified_profiles", "created_at"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "artifact_id": { "type": "string", "pattern": "^ma_[a-z0-9_]{1,64}$" },
    "model_family": { "type": "string", "enum": ["qwen"] },
    "architecture": { "type": "string", "pattern": "^approved_[a-z0-9_]{1,64}$" },
    "model_version": { "type": "string", "minLength": 1, "maxLength": 128 },
    "weight_format": { "const": "safetensors" },
    "precision": { "type": "string", "enum": ["bf16", "fp16", "fp32"] },
    "vocab_size": { "type": "integer", "minimum": 1 },
    "hidden_size": { "type": "integer", "minimum": 1 },
    "num_layers": { "type": "integer", "minimum": 1 },
    "num_attention_heads": { "type": "integer", "minimum": 1 },
    "num_key_value_heads": { "type": "integer", "minimum": 1 },
    "head_dim": { "type": "integer", "minimum": 1 },
    "max_context_tokens": { "type": "integer", "minimum": 1 },
    "intermediate_size": { "type": "integer", "minimum": 1 },
    "rms_norm_eps": { "type": "number", "exclusiveMinimum": 0 },
    "rope_theta": { "type": "number", "exclusiveMinimum": 0 },
    "tie_word_embeddings": { "type": "boolean" },
    "eos_token_ids": {
      "type": "array",
      "items": { "type": "integer", "minimum": 0 },
      "minItems": 1, "maxItems": 8
    },
    "tokenizer_type": { "type": "string", "pattern": "^approved_[a-z0-9_]{1,64}$" },
    "chat_template_id": { "type": "string", "pattern": "^[a-z0-9_]{1,64}$" },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "size_bytes"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "description": "Relative path inside the artifact. Absolute paths, '..' segments, and symlinks are rejected by the loader.",
            "pattern": "^[A-Za-z0-9._][A-Za-z0-9._/-]*$"
          },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "size_bytes": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "license_review_id": { "type": "string", "pattern": "^lic_[a-z0-9_]{1,64}$" },
    "certified_profiles": {
      "type": "array",
      "items": { "type": "string", "pattern": "^cp_[a-z0-9_]{1,64}$" }
    },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
